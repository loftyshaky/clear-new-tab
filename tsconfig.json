{
    "compilerOptions": {
        "rootDir": ".",
        "outDir": "dist",
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "esModuleInterop": true,
        "sourceMap": true,
        "skipLibCheck": true,
        "typeRoots": ["node_modules/@types"],
        "paths": {
            "shared_clean/*": ["./src/ts/shared_clean/*"],
            "shared/*": ["./src/ts/shared/*"],
            "announcement/*": ["./src/ts/announcement/*"],
            "background/*": ["./src/ts/background/*"],
            "settings/*": ["./src/ts/settings/*"],
            "new_tab/*": ["./src/ts/new_tab/*"],
            "offscreen/*": ["./src/ts/offscreen/*"],
            "sandbox/*": ["./src/ts/sandbox/*"],
            "dependencies/*": ["./src/ts/dependencies/*"]
        }
    },
    "files": ["node_modules/@loftyshaky/shared/src/ts/custom.d.ts"],
    "include": ["src/ts/**/*", "build/**/*"]
}
